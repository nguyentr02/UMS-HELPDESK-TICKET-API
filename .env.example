# M31 Helpdesk API — environment (copy to .env for local dev)

# Postgres — docker-compose ships one on :5433 (different port from feat-admission-plan)
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5433/helpdesk?schema=public"

# Redis — docker-compose ships one on :6380. In prod: Upstash.
REDIS_URL="redis://localhost:6380"

# Auth: 'jwt' (prod default) = HttpOnly Secure SameSite=None cookie; 'mock' = X-Mock-* headers (dev/test only).
AUTH_MODE=jwt

# Required when AUTH_MODE=jwt. HS256 signing key (≥ 32 chars). Rotate to invalidate all sessions.
JWT_SECRET=replace-me-with-a-32-plus-char-random-string-thanks

# Required when AUTH_MODE=jwt. Comma-separated origins allowed to send credentialed requests.
# Prod: the deployed FE origin. Dev: http://localhost:3000 (Next.js default).
CORS_ORIGIN=https://umshelpdesk.vercel.app,http://localhost:3000

# Attachment storage: 'local' = ./uploads ; 'blob' = Vercel Blob ; 's3' = S3/R2 (FP §K open item).
STORAGE_DRIVER=local

# EventPublisher: 'logger' (dev) | 'qstash' (Vercel prod).
EVENT_PUBLISHER_DRIVER=logger

# POST /jobs/daily-reminder bearer token (Vercel Cron + local worker).
JOB_SECRET=dev-secret-change-me

# Module kill-switch (FP §L rollback).
HELPDESK_ENABLED=true

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# App port (local only; on Vercel the handler is invoked by the platform).
PORT=4000
