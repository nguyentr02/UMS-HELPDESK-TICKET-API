{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'serverless-only build — no static output'",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/jobs/daily-reminder",
      "schedule": "0 2 * * 1-5"
    },
    {
      "path": "/jobs/blob-sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
